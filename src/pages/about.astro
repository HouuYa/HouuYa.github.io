---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import { Content, frontmatter } from '../data/about.md';
---

<BaseLayout
  title={`${frontmatter.title} — HouuYa's Blog`}
  description={frontmatter.description}
>
  <Nav />
  <main class="about-page">
    <div class="container">
      <header class="about-page__header">
        <h1 class="about-page__title">{frontmatter.title}</h1>
        <p class="about-page__lead">{frontmatter.lead ?? frontmatter.excerpt}</p>
      </header>

      <div class="about-page__body prose">
        <Content />
      </div>
    </div>
  </main>
</BaseLayout>

<style lang="scss">
  @use '../styles/tokens' as *;

  .about-page {
    background: $color-canvas;
    padding: $spacing-section 0;
    min-height: 60vh;

    &__header {
      max-width: 720px;
      margin-bottom: $spacing-xxl;
    }

    &__title {
      font-family: $font-display;
      font-size: $text-display-lg-size;
      font-weight: $font-display-weight;
      letter-spacing: $text-display-lg-ls;
      color: $color-ink;
      margin: 0 0 $spacing-md;
    }

    &__lead {
      font-family: $font-body;
      font-size: 18px;
      color: $color-body-strong;
      margin: 0;
    }

    &__body {
      max-width: 720px;

      h2 {
        margin-top: $spacing-xxl;
        margin-bottom: $spacing-lg;
        word-break: keep-all;
      }

      h3 {
        margin-top: $spacing-xl;
        margin-bottom: $spacing-md;
        word-break: keep-all;
      }

      h4 {
        margin-top: $spacing-lg;
        margin-bottom: $spacing-sm;
        word-break: keep-all;
      }

      p, li {
        word-break: keep-all;
        overflow-wrap: break-word;
      }

      strong {
        color: $color-body-strong;
        font-weight: 500;
      }

      a {
        color: $color-primary;
        text-decoration: underline;
        text-decoration-color: rgba($color-primary, 0.4);

        &:hover { text-decoration-color: $color-primary; }
      }
    }
  }
</style>
