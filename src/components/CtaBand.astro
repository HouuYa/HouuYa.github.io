---
// DESIGN.md: cta-band-coral — primary bg, on-primary text, rounded-lg, padding 64px
interface Props {
  headline?: string;
  sub?: string;
  primaryLabel?: string;
  primaryHref?: string;
}

const {
  headline = '규제와 기술 사이,\n실무 관점의 이야기',
  sub = 'EU AI Act · AI 거버넌스 · 기술 표준 분야의 글을 모아 두었습니다.',
  primaryLabel = '글 전체 보기 →',
  primaryHref = '/posts/',
} = Astro.props;

const resources = [
  { label: 'EU AI법과 우리나라 적용 시사점 — 글 전체 목차', href: '/ai-regulation-series/' },
  { label: 'AI 규제 분석 대응서 — 웹으로 읽기', href: '/ai-regulation-report/' },
  { label: 'AI 규제 분석 대응서 — PDF 내려받기', href: '/assets/pdfs/신뢰의-설계자들.pdf' },
];
---

<section class="cta-band">
  <div class="cta-band__inner container">
    <div class="cta-band__copy">
      <h2 class="cta-band__headline">{headline}</h2>
      <p class="cta-band__sub">{sub}</p>
    </div>
    <div class="cta-band__actions">
      <a href={primaryHref} class="cta-band__btn cta-band__btn--cream">{primaryLabel}</a>
      <div class="cta-band__resources">
        {resources.map(r => (
          <a href={r.href} class="cta-band__pill">{r.label}</a>
        ))}
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  @use '../styles/tokens' as *;

  .cta-band {
    padding: $spacing-section 0;

    &__inner {
      background: $color-primary;
      border-radius: $rounded-lg;
      padding: 64px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: $spacing-xxl;
    }

    &__copy {
      display: flex;
      flex-direction: column;
      gap: $spacing-md;
    }

    &__headline {
      font-family: $font-display;
      font-size: $text-display-sm-size;
      font-weight: $font-display-weight;
      line-height: $text-display-sm-lh;
      letter-spacing: $text-display-sm-ls;
      color: $color-on-primary;
      margin: 0;
      white-space: pre-line;
      word-break: keep-all;
      overflow-wrap: break-word;
    }

    &__sub {
      font-family: $font-body;
      font-size: $text-body-md-size;
      color: rgba($color-on-primary, 0.8);
      margin: 0;
      max-width: 480px;
      word-break: keep-all;
      overflow-wrap: break-word;
    }

    &__actions {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: $spacing-md;
      flex-shrink: 0;
    }

    &__resources {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 8px;
    }

    &__pill {
      display: inline-flex;
      align-items: center;
      font-family: $font-body;
      font-size: $text-caption-upper-size;
      font-weight: 500;
      color: $color-ink;
      background: $color-surface-card;
      border-radius: $rounded-pill;
      padding: 4px 12px;
      text-decoration: none;
      white-space: nowrap;
      transition: background 0.15s ease;

      &:hover { background: $color-canvas; }
    }

    &__btn {
      display: inline-flex;
      align-items: center;
      font-family: $font-body;
      font-size: $text-button-size;
      font-weight: 500;
      padding: 12px 20px;
      height: 40px;
      border-radius: $rounded-md;
      text-decoration: none;
      white-space: nowrap;
      transition: background 0.15s ease;

      &--cream {
        background: $color-canvas;
        color: $color-ink;

        &:hover { background: $color-surface-soft; }
      }
    }
  }

  @media (max-width: 767px) {
    .cta-band__inner {
      flex-direction: column;
      align-items: flex-start;
      padding: 40px 24px;
    }

    .cta-band__actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;

      .cta-band__btn { justify-content: center; }
    }

    .cta-band__resources {
      align-items: flex-start;
    }
  }
</style>
