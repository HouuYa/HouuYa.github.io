---
// 최근 포스트 목록용 카드 — canvas bg, hairline border, badge-pill 카테고리
import { slugify } from '../utils/slugify';

interface Props {
  title: string;
  slug: string;
  href?: string;
  pubDate?: Date | string | null;
  categories?: string[];
  description?: string | null;
}

const { title, slug, href, pubDate, categories = [], description } = Astro.props;
const linkHref = href || `/posts/${slug}/`;

function formatDate(d: Date | string | null | undefined): string {
  if (!d) return '';
  const date = d instanceof Date ? d : new Date(d);
  if (isNaN(date.getTime())) return '';
  return date.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });
}

const dateStr = formatDate(pubDate);
const primaryCat = categories[0];
---

<article class="post-card">
  <a href={linkHref} class="post-card__link" tabindex="-1" aria-hidden="true"></a>
  <div class="post-card__meta">
    {primaryCat && (
      <a href={`/categories/${slugify(primaryCat)}/`} class="post-card__badge">{primaryCat}</a>
    )}
    {dateStr && <time class="post-card__date">{dateStr}</time>}
  </div>
  <h3 class="post-card__title">
    <a href={linkHref}>{title}</a>
  </h3>
  {description && <p class="post-card__desc">{description}</p>}
</article>

<style lang="scss">
  @use '../styles/tokens' as *;

  .post-card {
    position: relative;
    background: $color-canvas;
    border: 1px solid $color-hairline;
    border-radius: $rounded-lg;
    padding: $spacing-xl;
    display: flex;
    flex-direction: column;
    gap: $spacing-sm;
    transition: border-color 0.15s ease;

    &:hover { border-color: $color-muted-soft; }

    // 전체 카드 클릭 영역
    &__link {
      position: absolute;
      inset: 0;
      border-radius: $rounded-lg;
    }

    &__meta {
      display: flex;
      align-items: center;
      gap: $spacing-xs;
    }

    &__badge {
      font-family: $font-body;
      font-size: $text-caption-size;
      font-weight: 500;
      background: $color-surface-card;
      color: $color-ink;
      border-radius: $rounded-pill;
      padding: 4px 12px;
      position: relative;
      z-index: 1;
    }

    &__date {
      font-family: $font-body;
      font-size: $text-body-sm-size;
      color: $color-muted;
    }

    &__title {
      font-family: $font-display;
      font-size: $text-title-md-size;
      font-weight: $font-display-weight;
      line-height: $text-title-md-lh;
      color: $color-ink;
      margin: 0;

      a {
        color: inherit;
        text-decoration: none;
        position: relative;
        z-index: 1;

        &:hover { color: $color-primary; }
      }
    }

    &__desc {
      font-family: $font-body;
      font-size: $text-body-sm-size;
      line-height: $text-body-sm-lh;
      color: $color-body;
      margin: 0;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }
</style>
